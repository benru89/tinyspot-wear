-        {{"Content-Type", "application/x-protobuf"}}, encodedRequest);
-
-    auto responseBytes = response->bytes();
+    // Perform a login5 request, containing the encoded protobuf data. A
+    // network error here (TLS handshake, DNS during a Wi-Fi/LTE switch) must
+    // not escape: this runs on the queue task, which has no handler.
+    std::vector<uint8_t> responseBytes;
+    try {
+      auto response = bell::HTTPClient::post(
+          "https://login5.spotify.com/v3/login",
+          {{"Content-Type", "application/x-protobuf"}}, encodedRequest);
+      responseBytes = response->bytes();
+    } catch (const std::exception& e) {
+      CSPOT_LOG(error, "Access token request failed: %s", e.what());
+      BELL_SLEEP_MS(3000);
+      retryCount--;
+      continue;
+    }
 
     // Deserialize the response
     pbDecode(loginResponse, LoginResponse_fields, responseBytes);
