@@ -99,12 +100,21 @@ void AccessKeyFetcher::updateAccessKey() {
     CSPOT_LOG(info, "Access token expired, fetching new one... %d",
               encodedRequest.size());
 
-    // Perform a login5 request, containing the encoded protobuf data
