+void SpircHandler::loadTrackFromURI(const std::string& uri) {
+  loadTracks({uri}, 0, uri);
+}
+
+void SpircHandler::loadTracks(const std::vector<std::string>& trackUris,
+                              uint32_t index, const std::string& contextUri) {
+  if (trackUris.empty() || index >= trackUris.size()) {
+    return;
+  }
+  this->trackPlayer->start();
+
+  // Same state a remote Load frame would produce
+  playbackState->remoteTracks.clear();
+  for (const auto& uri : trackUris) {
+    TrackReference ref;
+    ref.uri = uri;
+    ref.context = contextUri;
+    ref.decodeURI();
+    // base62 decoding drops leading zero bytes; GIDs are 16 bytes
+    while (ref.gid.size() < 16) {
+      ref.gid.insert(ref.gid.begin(), 0);
+    }
+    playbackState->remoteTracks.push_back(ref);
+  }
+
+  playbackState->setActive(true);
+  playbackState->updatePositionMs(0);
+  playbackState->setPlaybackState(PlaybackState::State::Playing);
+
+  auto& state = playbackState->innerFrame.state;
+  state.context_uri =
+      (char*)realloc(state.context_uri, contextUri.size() + 1);
+  strcpy(state.context_uri, contextUri.c_str());
+  state.has_playing_track_index = true;
+  state.playing_track_index = index;
+
+  CSPOT_LOG(info, "Local load: %d tracks, starting at %d",
+            (int)trackUris.size(), (int)index);
+  trackQueue->updateTracks(0, true);
+  this->notify();
+  trackPlayer->resetState();
+}
 
