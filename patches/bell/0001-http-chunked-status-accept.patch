 void HTTPClient::Response::readRawBody() {
-  if (contentSize > 0 && rawBody.size() == 0) {
+  if (bodyRead) {
+    return;
+  }
+  bodyRead = true;
+
+  if (contentSize > 0) {
     rawBody = std::vector<uint8_t>(contentSize);
     socketStream.read((char*)rawBody.data(), contentSize);
+    return;
+  }
+
+  std::string encoding(header("transfer-encoding"));
+  std::transform(encoding.begin(), encoding.end(), encoding.begin(),
+                 [](unsigned char c) { return std::tolower(c); });
+  if (encoding.find("chunked") == std::string::npos) {
+    return;
+  }
+
+  // Transfer-Encoding: chunked -> "<hex size>[;ext]\r\n<data>\r\n" ... "0\r\n\r\n"
+  std::string line;
+  while (std::getline(socketStream, line)) {
+    size_t chunkSize = std::strtoul(line.c_str(), nullptr, 16);
+    if (chunkSize == 0) {
+      std::getline(socketStream, line);  // trailer terminator
+      break;
+    }
+    size_t offset = rawBody.size();
+    rawBody.resize(offset + chunkSize);
+    socketStream.read((char*)rawBody.data() + offset, chunkSize);
+    std::getline(socketStream, line);  // CRLF after the chunk
   }
 }
 
